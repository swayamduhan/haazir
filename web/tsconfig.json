{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": { "@shared/*": ["../packages/shared/src/*"] }
  },
  "include": ["src", "test", "vite.config.ts"]
}
