# MSP ID per organization role.
#
# Phase A (spec 4.2): stock fabric-samples identifiers, so a known-good
# network exists as a fallback before any customisation.
# Phase B rewrites these to RegistrarMSP / ExamCellMSP / AuditMSP once the
# channel configuration has been rebuilt with the new identifiers.
#
# Everything else reads the mapping from here, so switching phases is a
# one-file change and reverting is trivial.

REGISTRAR_MSP=Org1MSP
EXAMCELL_MSP=Org2MSP
AUDIT_MSP=Org3MSP
